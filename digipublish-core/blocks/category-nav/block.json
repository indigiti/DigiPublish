{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "digipublish/category-nav",
  "version": "0.11.0",
  "title": "Category Navigation",
  "category": "digipublish-editorial",
  "icon": "menu-alt3",
  "description": "Caards-style category navigation with filtering and ordering controls.",
  "textdomain": "digipublish-core",
  "attributes": {
    "limit": {
      "type": "integer",
      "default": 5
    },
    "showDictionary": {
      "type": "boolean",
      "default": true
    },
    "showSearch": {
      "type": "boolean",
      "default": true
    },
    "filterSlugs": {
      "type": "string",
      "default": ""
    },
    "orderBy": {
      "type": "string",
      "default": "count"
    },
    "order": {
      "type": "string",
      "default": "DESC"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "className": true
  },
  "editorScript": "digipublish-core-editor",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
