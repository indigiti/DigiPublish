{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "digipublish/category-nav",
  "version": "0.11.1",
  "title": "Category Navigation",
  "category": "digipublish-editorial",
  "icon": "menu-alt3",
  "description": "Editorial category navigation with filtering, ordering, dictionary, gallery and search links.",
  "textdomain": "digipublish-core",
  "attributes": {
    "limit": {
      "type": "integer",
      "default": 0
    },
    "showDictionary": {
      "type": "boolean",
      "default": false
    },
    "showSearch": {
      "type": "boolean",
      "default": false
    },
    "filterSlugs": {
      "type": "string",
      "default": ""
    },
    "orderBy": {
      "type": "string",
      "default": "name"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "filterCategoryIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "integer"
      }
    },
    "maximum": {
      "type": "integer",
      "default": 0
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "hideDesktop": {
      "type": "boolean",
      "default": false
    },
    "hideLaptop": {
      "type": "boolean",
      "default": false
    },
    "hideTablet": {
      "type": "boolean",
      "default": false
    },
    "hideMobile": {
      "type": "boolean",
      "default": false
    },
    "showGallery": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "border": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true
    },
    "visibility": true
  },
  "editorScript": "digipublish-core-editor",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
