{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "677px",
      "wideSize": "1360px",
      "allowEditing": true,
      "allowCustomContentAndWideSize": true
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "site",
          "name": "Canvas",
          "color": "#E6E9EB"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F6F7F8"
        },
        {
          "slug": "white",
          "name": "Surface Raised",
          "color": "#FFFFFF"
        },
        {
          "slug": "primary",
          "name": "Text",
          "color": "#2F323D"
        },
        {
          "slug": "secondary",
          "name": "Text Muted",
          "color": "#59636D"
        },
        {
          "slug": "accent",
          "name": "Brand",
          "color": "#2D5DE0"
        },
        {
          "slug": "accent-hover",
          "name": "Brand Hover",
          "color": "#1048DE"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#DEE2E6"
        },
        {
          "slug": "dark",
          "name": "Surface Dark",
          "color": "#1B1C1F"
        },
        {
          "slug": "dark-site",
          "name": "Canvas Dark",
          "color": "#30323E"
        }
      ],
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultDuotone": false
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "8px"
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "12px"
        },
        {
          "slug": "md",
          "name": "M",
          "size": "16px"
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "24px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "32px"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "48px"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "64px"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "96px"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "customSpacingSize": true
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "DigiPublish Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "sans",
          "name": "Editorial Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "reading",
          "name": "Reading Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "md",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "1.125rem"
        },
        {
          "slug": "xl",
          "name": "H4",
          "size": "1.375rem"
        },
        {
          "slug": "2xl",
          "name": "H3",
          "size": "1.75rem"
        },
        {
          "slug": "3xl",
          "name": "H2",
          "size": "2.25rem"
        },
        {
          "slug": "4xl",
          "name": "H1",
          "size": "clamp(2.5rem,5vw,4.75rem)"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(3rem,7vw,6.5rem)"
        }
      ],
      "customFontSize": true
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "name": "Card",
          "shadow": "0 12px 40px rgba(47,50,61,.08)"
        },
        {
          "slug": "floating",
          "name": "Floating",
          "shadow": "0 20px 70px rgba(47,50,61,.16)"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/group": {
        "border": {
          "radius": true
        }
      },
      "core/image": {
        "border": {
          "radius": true
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|site",
      "text": "var:preset|color|primary"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|manrope",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.5"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|md",
        "right": "var:preset|spacing|md"
      }
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "700",
          "lineHeight": "1.08",
          "letterSpacing": "-0.035em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|4xl"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|3xl"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|2xl"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "6px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "11px",
            "right": "18px",
            "bottom": "11px",
            "left": "18px"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "lineHeight": "1.65"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "700",
          "lineHeight": "1.08",
          "letterSpacing": "-0.035em"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontSize": "0.75rem",
          "fontWeight": "600"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "single-standard",
      "title": "DigiPublish Post — Standard",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-large",
      "title": "DigiPublish Post — Large Hero",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-full",
      "title": "DigiPublish Post — Full Hero",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-title",
      "title": "DigiPublish Post — Title Only",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "single-no-sidebar",
      "title": "DigiPublish Post — No Sidebar",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "page-large",
      "title": "DigiPublish Page — Large Hero",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-full",
      "title": "DigiPublish Page — Full Hero",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-title",
      "title": "DigiPublish Page — Title Only",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-no-title",
      "title": "DigiPublish Page — No Header",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "meet-team",
      "title": "DigiPublish Meet Team",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header — DigiPublish 1",
      "area": "header"
    },
    {
      "name": "header-one",
      "title": "Header — DigiPublish 1",
      "area": "header"
    },
    {
      "name": "header-two",
      "title": "Header — DigiPublish 2",
      "area": "header"
    },
    {
      "name": "header-three",
      "title": "Header — DigiPublish 3",
      "area": "header"
    },
    {
      "name": "header-four",
      "title": "Header — DigiPublish 4",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer — DigiPublish 1",
      "area": "footer"
    },
    {
      "name": "footer-one",
      "title": "Footer — DigiPublish 1",
      "area": "footer"
    },
    {
      "name": "footer-two",
      "title": "Footer — DigiPublish 2",
      "area": "footer"
    },
    {
      "name": "footer-three",
      "title": "Footer — DigiPublish 3",
      "area": "footer"
    },
    {
      "name": "footer-four",
      "title": "Footer — DigiPublish 4",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Article Sidebar",
      "area": "uncategorized"
    }
  ]
}
