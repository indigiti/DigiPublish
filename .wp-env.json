{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.1.2.zip",
  "phpVersion": "8.2",
  "plugins": [
    "./digipublish-core"
  ],
  "themes": [
    "./digipublish"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": false
  },
  "lifecycleScripts": {
    "afterStart": "for SERVICE in cli tests-cli; do wp-env run \"$SERVICE\" wp theme activate digipublish; done"
  }
}
